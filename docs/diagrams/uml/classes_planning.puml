dmas.models.planning.decentralized.announcer.AbstractEventAnnouncerPlanner --|> dmas.models.planning.periodic.AbstractPeriodicPlanner
dmas.models.planning.decentralized.announcer.GroundProcessorEventAnnouncerPlanner --|> dmas.models.planning.decentralized.announcer.AbstractEventAnnouncerPlanner
dmas.models.planning.decentralized.announcer.InstantEventAnnouncerPlanner --|> dmas.models.planning.decentralized.announcer.AbstractEventAnnouncerPlanner
dmas.models.planning.decentralized.blank.BlankPlanner --|> dmas.models.planning.periodic.AbstractPeriodicPlanner
dmas.models.planning.decentralized.default.FixedPointingDefaultPlanner --|> dmas.models.planning.reactive.AbstractReactivePlanner
dmas.models.planning.decentralized.dynamic.DynamicProgrammingPlanner --|> dmas.models.planning.periodic.AbstractPeriodicPlanner
dmas.models.planning.decentralized.earliest.EarliestAccessPeriodicPlanner --|> dmas.models.planning.decentralized.heuristic.HeuristicInsertionPeriodicPlanner
dmas.models.planning.decentralized.earliest.EarliestAccessReactivePlanner --|> dmas.models.planning.decentralized.heuristic.HeuristicInsertionReactivePlanner
dmas.models.planning.decentralized.earliest.EarliestRequestArrivalPeriodicPlanner --|> dmas.models.planning.decentralized.heuristic.HeuristicInsertionPeriodicPlanner
dmas.models.planning.decentralized.earliest.EarliestRequestArrivalReactivePlanner --|> dmas.models.planning.decentralized.heuristic.HeuristicInsertionReactivePlanner
dmas.models.planning.decentralized.heuristic.HeuristicInsertionPeriodicPlanner --|> dmas.models.planning.periodic.AbstractPeriodicPlanner
dmas.models.planning.decentralized.heuristic.HeuristicInsertionReactivePlanner --|> dmas.models.planning.reactive.AbstractReactivePlanner
dmas.models.planning.decentralized.nadir.NadirPointingPeriodicPlanner --|> dmas.models.planning.decentralized.earliest.EarliestAccessPeriodicPlanner
dmas.models.planning.decentralized.nadir.NadirPointingReactivePlanner --|> dmas.models.planning.decentralized.earliest.EarliestAccessReactivePlanner
dmas.models.planning.periodic.AbstractPeriodicPlanner --|> dmas.models.planning.planner.AbstractPlanner
