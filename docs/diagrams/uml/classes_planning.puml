@startuml classes_planning
set namespaceSeparator none
class "AbstractEventAnnouncerPlanner" as dmas.models.planning.decentralized.announcer.AbstractEventAnnouncerPlanner {
  generate_plan(state: SimulationAgentState, _: object, orbitdata: OrbitData) -> Plan
  load_events(events_path: str) -> pd.DataFrame
}
class "AbstractPeriodicPlanner" as dmas.models.planning.periodic.AbstractPeriodicPlanner {
  GROUND_BASED : str
  NONE : str
  OPPORTUNISTIC : str
  PERIODIC : str
  pending_reqs_to_broadcast : set[TaskRequest]
  generate_plan(state: SimulationAgentState, specs: object, orbitdata: OrbitData, mission: Mission, tasks: list, observation_history: TaskObservationTracker) -> Plan
  get_available_tasks(tasks: list, planning_horizon: Interval) -> list
  get_ground_points(orbitdata: OrbitData) -> dict
  needs_planning(state: SimulationAgentState, __: object, current_plan: Plan) -> bool
  print_results()
  update_percepts(state: SimulationAgentState, current_plan: Plan, tasks: Dict[Tuple, GenericObservationTask], incoming_reqs: Dict[Tuple, Dict], misc_messages: list, completed_actions: list, aborted_actions: list, pending_actions: list) -> None
}
class "AbstractPlanner" as dmas.models.planning.planner.AbstractPlanner {
  EPS : float
  latest_performed_observations : Set[ObservationOpportunity]
  calculate_access_opportunities(tasks: List[GenericObservationTask], planning_horizon: Interval, orbitdata: OrbitData) -> dict
  check_task_observation_opportunity_clusterability(observation_opportunities: List[ObservationOpportunity], must_overlap: bool, threshold: float) -> dict
  cluster_task_observation_opportunities(observation_opportunities: List[ObservationOpportunity], adj: Dict[str, Set[ObservationOpportunity]], must_overlap: bool, threshold: float) -> list
  create_observation_opportunities_from_accesses(available_tasks: List[GenericObservationTask], access_times: List[tuple], cross_track_fovs: dict, orbitdata: OrbitData, must_overlap: bool, threshold: float) -> list
  estimate_observation_opportunity_value(obs: ObservationOpportunity, t_img: float, d_img: float, specs: object, cross_track_fovs: Dict[str, float], orbitdata: OrbitData, mission: Mission, observation_history: TaskObservationTracker, task_n_obs: Dict[GenericObservationTask, int], task_t_prevs: Dict[GenericObservationTask, int], task_t_imgs: Dict[str, float]) -> float
  {abstract}generate_plan() -> Plan
  get_available_accesses(task: GenericObservationTask, instrument_name: str, th_img: float, t_img: float, d_img: float, orbitdata: OrbitData, cross_track_fovs: dict) -> dict
  is_maneuver_path_valid(state: SimulationAgentState, specs: object, observations: List[ObservationAction], maneuvers: List[ManeuverAction], max_slew_rate: float, cross_track_fovs: dict) -> bool
  is_observation_pair_valid(t_i, d_i, th_i, t_j, d_j, th_j, max_slew_rate, start_pair) -> bool
  is_observation_path_valid(state: SimulationAgentState, observations: List[ObservationAction], max_slew_rate: float, max_torque: float, specs: object) -> bool
  {abstract}needs_planning() -> bool
  {abstract}print_results() -> None
  single_task_observation_opportunity_from_accesses(available_tasks: List[GenericObservationTask], access_times: Dict[Tuple, List[tuple]], cross_track_fovs: dict, orbitdata: OrbitData, threshold: float) -> List[ObservationOpportunity]
  {abstract}update_percepts(completed_actions: list) -> None
}
class "AbstractReactivePlanner" as dmas.models.planning.reactive.AbstractReactivePlanner {
  {abstract}generate_plan(state: SimulationAgentState, specs: object, current_plan: Plan, orbitdata: OrbitData, mission: Mission, tasks: List[GenericObservationTask], observation_history: TaskObservationTracker) -> Plan
  {abstract}update_percepts(state: SimulationAgentState, current_plan: Plan, tasks: List[GenericObservationTask], incoming_reqs: List[TaskRequest], misc_messages: List[SimulationMessage], completed_actions: List[AgentAction], aborted_actions: List[AgentAction], pending_actions: List[AgentAction]) -> None
}
