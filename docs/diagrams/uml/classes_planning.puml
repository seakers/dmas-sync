}
class "Plan" as dmas.models.planning.plan.Plan {
  actions : list[AgentAction]
  t : float
  t_next
  add(new_action: AgentAction, t: float) -> None
  add_all(actions: List[AgentAction], t: float, printouts: bool) -> None
  copy() -> object
  counters() -> dict
  empty(t: float) -> None
  get_horizon() -> float
  get_next_actions(t: float, earliest: bool, tolerance: float) -> list
  is_empty() -> bool
  remove(action: AgentAction, t: float) -> None
  update() -> None
  update_action_completion(completed_actions: List[AgentAction], aborted_actions: List[AgentAction], pending_actions: List[AgentAction], t: float) -> Tuple[list, list]
}
