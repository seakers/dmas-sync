dmas.models.planning.plan.ReactivePlan --|> dmas.models.planning.plan.Plan
dmas.models.planning.reactive.AbstractReactivePlanner --|> dmas.models.planning.planner.AbstractPlanner
dmas.models.planning.plan.PeriodicPlan --* dmas.models.planning.decentralized.announcer.AbstractEventAnnouncerPlanner : _plan
dmas.models.planning.plan.PeriodicPlan --* dmas.models.planning.decentralized.default.FixedPointingDefaultPlanner : _plan
dmas.models.planning.plan.PeriodicPlan --* dmas.models.planning.periodic.AbstractPeriodicPlanner : _plan
dmas.models.planning.plan.PeriodicPlan --* dmas.models.planning.periodic.AbstractPeriodicPlanner : _plan
dmas.models.planning.plan.PeriodicPlan --* dmas.models.planning.reactive.AbstractReactivePlanner : _preplan
dmas.models.planning.plan.ReactivePlan --* dmas.models.planning.decentralized.default.FixedPointingDefaultPlanner : _plan
dmas.models.planning.plan.ReactivePlan --* dmas.models.planning.decentralized.heuristic.HeuristicInsertionReactivePlanner : _plan
@enduml
